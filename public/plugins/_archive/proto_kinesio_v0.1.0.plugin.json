{
  "id": "proto_kinesio",
  "name": "Proto Kinesio",
  "specialty": "Kinésiologie (prototype)",
  "version": "0.1.0",
  "status": "draft",
  "description": "Prototype expérimental d'une nouvelle organisation de l'anamnèse Kinésiologie (conducteur de séance, mode Première consultation / Suivi). N'affecte pas le formulaire officiel kinesio_charlotte.",
  "icon": "🧭",
  "accentColor": "#8B6F9E",
  "hideGlobalMotif": true,
  "sections": [

    {
      "id": "type_de_seance",
      "title": "Type de séance",
      "placement": "pre-motif",
      "icon": "🧭",
      "accentColor": "#8B6F9E",
      "fields": [
        {
          "id": "type_seance",
          "type": "radio",
          "label": "Type de séance",
          "options": ["Première consultation", "Séance de suivi"],
          "width": "full",
          "hint": "Ce choix détermine les sections affichées ci-dessous."
        }
      ]
    },

    {
      "id": "motif_consultation",
      "title": "Motif de consultation",
      "placement": "motif",
      "icon": "🎯",
      "accentColor": "#9E7A5A",
      "visibleWhen": [{ "fieldId": "type_seance", "operator": "eq", "value": "Première consultation" }],
      "fields": [
        {
          "id": "problematique_principale",
          "type": "textarea",
          "label": "Problématique principale exprimée",
          "placeholder": "Ce que le consultant vient chercher, dans ses propres mots…",
          "hint": "Noter autant que possible les mots utilisés par le consultant.",
          "width": "full",
          "minHeight": 110
        },
        {
          "id": "anciennete_problematique",
          "type": "text",
          "label": "Depuis quand ?",
          "width": "half"
        },
        {
          "id": "contexte_apparition",
          "type": "textarea",
          "label": "Contexte d'apparition / événement déclencheur",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "solutions_deja_tentees",
          "type": "textarea",
          "label": "Solutions ou accompagnements déjà essayés",
          "hint": "Suivi médical ou paramédical, accompagnements, thérapies ou autres démarches déjà entreprises.",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "pourquoi_maintenant",
          "type": "textarea",
          "label": "Pourquoi consulter maintenant ?",
          "hint": "Déclic, événement récent, évolution ou changement particulier.",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "attentes_seance",
          "type": "textarea",
          "label": "Attentes vis-à-vis de la séance",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "benefice_disparition_probleme",
          "type": "textarea",
          "label": "Si cette problématique n'existait plus, qu'est-ce que cela vous permettrait de faire, de ressentir ou d'être ?",
          "width": "full",
          "minHeight": 90
        }
      ]
    },

    {
      "id": "accueil_observations",
      "title": "Accueil / Observations initiales",
      "placement": "notes",
      "icon": "🌿",
      "accentColor": "#7A9E7E",
      "visibleWhen": [{ "fieldId": "type_seance", "operator": "eq", "value": "Première consultation" }],
      "fields": [
        {
          "id": "observations_initiales",
          "type": "textarea",
          "label": "Observations initiales",
          "hint": "Posture, respiration, regard, gestuelle, variations de ton, réactions émotionnelles ou autres éléments observés lors de l'entretien.",
          "width": "full",
          "minHeight": 90
        }
      ]
    },

    {
      "id": "contexte_personnel_familial",
      "title": "Contexte personnel et familial",
      "placement": "notes",
      "icon": "👪",
      "accentColor": "#5A7E9E",
      "visibleWhen": [{ "fieldId": "type_seance", "operator": "eq", "value": "Première consultation" }],
      "fields": [
        {
          "id": "situation_conjugale",
          "type": "select",
          "label": "Situation conjugale",
          "options": [
            "Célibataire",
            "En couple",
            "Marié(e) / Pacsé(e)",
            "Séparé(e) / Divorcé(e)",
            "Veuf / Veuve",
            "Autre / à préciser"
          ],
          "width": "half"
        },
        {
          "id": "enfants_contexte",
          "type": "textarea",
          "label": "Enfants / contexte",
          "hint": "Prénoms, âges ou années de naissance, ordre de naissance et éléments pertinents si nécessaire.",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "nombre_freres",
          "type": "number",
          "label": "Nombre de frères",
          "min": 0,
          "width": "third"
        },
        {
          "id": "nombre_soeurs",
          "type": "number",
          "label": "Nombre de sœurs",
          "min": 0,
          "width": "third"
        },
        {
          "id": "place_fratrie",
          "type": "select",
          "label": "Place dans la fratrie",
          "options": [
            "Enfant unique",
            "Aîné(e)",
            "Cadet(te)",
            "Benjamin(e)",
            "Autre / situation particulière"
          ],
          "width": "third"
        },
        {
          "id": "contexte_familial",
          "type": "textarea",
          "label": "Situation et contexte familial actuel",
          "width": "full",
          "minHeight": 80
        },
        {
          "id": "evenements_familiaux",
          "type": "textarea",
          "label": "Événements familiaux significatifs",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "contexte_professionnel",
          "type": "textarea",
          "label": "Situation et contexte professionnel actuel",
          "width": "full",
          "minHeight": 80
        }
      ]
    },

    {
      "id": "historique_hygiene_vie",
      "title": "Historique et hygiène de vie",
      "placement": "notes",
      "icon": "🌞",
      "accentColor": "#8B9E5E",
      "visibleWhen": [{ "fieldId": "type_seance", "operator": "eq", "value": "Première consultation" }],
      "fields": [
        {
          "id": "antecedents_sante",
          "type": "textarea",
          "label": "Antécédents / éléments de santé pertinents",
          "width": "full",
          "minHeight": 80
        },
        {
          "id": "traitements_suivis",
          "type": "textarea",
          "label": "Traitements ou suivis en cours",
          "hint": "Médicaments, suivis médicaux ou paramédicaux et autres accompagnements pertinents. La kinésiologie ne constitue pas un diagnostic médical et ne se substitue pas à un suivi ou à un traitement médical.",
          "width": "full",
          "minHeight": 80
        },
        {
          "id": "qualite_sommeil",
          "type": "radio",
          "label": "Sommeil",
          "options": ["Très mauvais", "Mauvais", "Perturbé", "Correct", "Bon"],
          "width": "half"
        },
        {
          "id": "sommeil_details",
          "type": "textarea",
          "label": "Sommeil — précisions",
          "width": "half",
          "minHeight": 60
        },
        {
          "id": "emotions_actuelles",
          "type": "textarea",
          "label": "Émotions actuellement prédominantes",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "vision_avenir",
          "type": "textarea",
          "label": "Vision de l'avenir / perception actuelle",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "hygiene_vie",
          "type": "textarea",
          "label": "Hygiène de vie / éléments fonctionnels",
          "hint": "Rythme de vie, activité physique, alimentation, fatigue, récupération ou autres éléments pertinents.",
          "width": "full",
          "minHeight": 70
        }
      ]
    },

    {
      "id": "evolution_depuis_derniere_seance",
      "title": "Bilan depuis la dernière séance",
      "placement": "notes",
      "icon": "📈",
      "accentColor": "#0D9488",
      "visibleWhen": [{ "fieldId": "type_seance", "operator": "eq", "value": "Séance de suivi" }],
      "fields": [
        {
          "id": "suivi_periode",
          "type": "textarea",
          "label": "Comment s'est passée la période depuis la dernière séance ?",
          "width": "full",
          "minHeight": 90
        },
        {
          "id": "suivi_ameliorations",
          "type": "textarea",
          "label": "Changements positifs constatés",
          "width": "half",
          "minHeight": 80
        },
        {
          "id": "suivi_difficultes",
          "type": "textarea",
          "label": "Difficultés encore présentes",
          "width": "half",
          "minHeight": 80
        },
        {
          "id": "suivi_evenements",
          "type": "textarea",
          "label": "Nouveaux événements depuis la dernière séance",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "evolution_objectif_precedent",
          "type": "select",
          "label": "Évolution de l'objectif précédent",
          "options": [
            "Objectif atteint",
            "Amélioration nette",
            "Amélioration partielle",
            "Stable",
            "Difficulté revenue",
            "Non évalué"
          ],
          "width": "half"
        },
        {
          "id": "evolution_objectif_commentaire",
          "type": "textarea",
          "label": "Commentaire sur l'évolution",
          "width": "half",
          "minHeight": 60
        },
        {
          "id": "priorite_du_jour",
          "type": "textarea",
          "label": "Priorité / demande aujourd'hui",
          "width": "full",
          "minHeight": 80
        }
      ]
    },

    {
      "id": "etat_debut_seance",
      "title": "État au début de la séance",
      "placement": "notes",
      "icon": "📍",
      "accentColor": "#5A7E9E",
      "fields": [
        {
          "id": "stress_debut",
          "type": "rating",
          "label": "Stress / tension ressentie au début",
          "min": 0,
          "max": 10,
          "width": "third",
          "hint": "0 = très calme / aucune tension · 10 = tension maximale ressentie"
        }
      ]
    },

    {
      "id": "objectif_seance",
      "title": "Objectif de la séance",
      "placement": "notes",
      "icon": "🎯",
      "accentColor": "#9E7A5A",
      "fields": [
        {
          "id": "changement_recherche",
          "type": "textarea",
          "label": "Changement recherché",
          "width": "full",
          "minHeight": 80
        },
        {
          "id": "benefice_attendu",
          "type": "textarea",
          "label": "Ce que ce changement permettrait",
          "width": "full",
          "minHeight": 70
        },
        {
          "id": "objectif_seance_texte",
          "type": "textarea",
          "label": "Objectif formulé pour la séance",
          "hint": "Repères : formulation positive, au présent, personnelle, significative et suffisamment concrète pour pouvoir être réévaluée.",
          "width": "full",
          "minHeight": 80
        },
        {
          "id": "indicateurs_reussite",
          "type": "textarea",
          "label": "Indicateurs de réussite",
          "hint": "Comment le consultant pourra-t-il constater qu'un changement s'est produit ?",
          "width": "full",
          "minHeight": 70
        }
      ]
    },

    {
      "id": "equilibrage_effectue",
      "title": "Équilibrage effectué",
      "placement": "traitement",
      "icon": "⚖️",
      "accentColor": "#7A5A9E",
      "fields": [
        {
          "id": "techniques_equilibrage",
          "type": "checkboxgroup",
          "label": "Techniques utilisées",
          "options": [
            "Test musculaire",
            "Points neuro-lymphatiques",
            "Points neuro-vasculaires",
            "Respiration consciente",
            "Mouvements oculaires",
            "Acupression",
            "Ancrage / enracinement",
            "Visualisation",
            "Affirmation positive",
            "Libération émotionnelle",
            "Mouvement intégrateur",
            "Intégration neurologique",
            "Autre"
          ],
          "width": "full"
        },
        {
          "id": "technique_autre",
          "type": "text",
          "label": "Autre technique — préciser",
          "width": "half",
          "visibleWhen": [{ "fieldId": "techniques_equilibrage", "operator": "includes", "value": "Autre" }]
        },
        {
          "id": "deroule_seance",
          "type": "richtext",
          "label": "Déroulé et observations de séance",
          "hint": "Éléments travaillés, réactions, moments clés, découvertes ou formulations importantes.",
          "width": "full",
          "minHeight": 140
        }
      ]
    },

    {
      "id": "fin_de_seance",
      "title": "Fin de séance",
      "placement": "traitement",
      "icon": "🌙",
      "accentColor": "#5A7E9E",
      "fields": [
        {
          "id": "stress_fin",
          "type": "rating",
          "label": "Stress / tension ressentie en fin de séance",
          "min": 0,
          "max": 10,
          "width": "third",
          "hint": "0 = très calme / aucune tension · 10 = tension maximale ressentie"
        },
        {
          "id": "ressenti_fin",
          "type": "checkboxgroup",
          "label": "Ressenti en fin de séance",
          "options": ["Très positif", "Positif", "Neutre", "Émotionnel", "Fatigué", "Apaisé", "Autre"],
          "width": "full"
        },
        {
          "id": "ressenti_fin_autre",
          "type": "text",
          "label": "Autre ressenti — préciser",
          "width": "half",
          "visibleWhen": [{ "fieldId": "ressenti_fin", "operator": "includes", "value": "Autre" }]
        },
        {
          "id": "point_vigilance",
          "type": "textarea",
          "label": "Point de vigilance",
          "width": "full",
          "minHeight": 60
        }
      ]
    },

    {
      "id": "suivi_anamnese",
      "title": "Intégration & suivi",
      "placement": "plan",
      "icon": "📅",
      "accentColor": "#5A7E9E",
      "hideTitle": true,
      "fields": [
        {
          "id": "bilan_seance",
          "type": "textarea",
          "label": "Bilan de la séance",
          "width": "full",
          "minHeight": 80
        },
        {
          "id": "changements_fin_seance",
          "type": "textarea",
          "label": "Changements observés entre le début et la fin de séance",
          "hint": "Évolution ressentie ou observée au cours de la séance : tension, émotion, perception, posture ou autre changement pertinent.",
          "width": "half",
          "minHeight": 60
        },
        {
          "id": "conseils_interseance",
          "type": "textarea",
          "label": "Exercices / intégration entre les séances",
          "hint": "Exercices, pratiques d'intégration, observations personnelles ou actions proposées jusqu'à la prochaine séance.",
          "width": "half",
          "minHeight": 60
        },
        {
          "id": "axes_travail",
          "type": "textarea",
          "label": "Pistes pour les prochaines séances",
          "hint": "Thèmes, objectifs ou éléments qui pourraient être repris lors des prochaines séances.",
          "width": "half",
          "minHeight": 60
        },
        {
          "id": "points_reevaluer",
          "type": "textarea",
          "label": "Éléments à réévaluer à la prochaine séance",
          "hint": "Éléments dont l'évolution devra être redemandée ou réévaluée lors du prochain rendez-vous.",
          "width": "half",
          "minHeight": 60
        },
        {
          "id": "suivi_envisage",
          "type": "select",
          "label": "Suivi envisagé",
          "options": [
            "2×/semaine",
            "1×/semaine",
            "Toutes les 2 semaines",
            "1×/mois",
            "À la demande",
            "Fin de suivi"
          ],
          "width": "half"
        }
      ]
    }

  ]
}
